{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Python: type check project",
      "type": "process",
      "command": "uv",
      "args": ["run", "--frozen", "pyright"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "HA: start debug container",
      "type": "process",
      "command": "uv",
      "args": ["run", "scripts/ha_dev.py", "up"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "HA: stop debug container",
      "type": "process",
      "command": "uv",
      "args": ["run", "scripts/ha_dev.py", "down"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
